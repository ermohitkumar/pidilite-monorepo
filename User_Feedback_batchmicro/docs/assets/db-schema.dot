digraph db_schema {
  graph [
    label="Pidilite User Feedback — PostgreSQL schema"
    labelloc=t
    fontsize=18
    fontname="Helvetica"
    fontcolor="#0f2744"
    bgcolor="white"
    pad=0.4
    rankdir=TB
    splines=true
    nodesep=0.45
    ranksep=0.7
    newrank=true
  ]
  node [shape=plain fontname="Helvetica" fontsize=11]
  edge [
    color="#334155"
    fontname="Helvetica"
    fontsize=9
    fontcolor="#475569"
    arrowsize=0.8
  ]

  users [
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#1e3a5f">
        <TR><TD BGCOLOR="#1e3a5f" COLSPAN="2"><FONT COLOR="white"><B>users</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT">user_id</TD><TD ALIGN="LEFT">uuid PK</TD></TR>
        <TR><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT">varchar UK</TD></TR>
        <TR><TD ALIGN="LEFT">username</TD><TD ALIGN="LEFT">varchar UK</TD></TR>
        <TR><TD ALIGN="LEFT">password_hash</TD><TD ALIGN="LEFT">varchar</TD></TR>
        <TR><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT">varchar</TD></TR>
        <TR><TD ALIGN="LEFT">allowed_resources</TD><TD ALIGN="LEFT">jsonb</TD></TR>
        <TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">boolean</TD></TR>
      </TABLE>
    >
  ]

  batches [
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#1e3a5f">
        <TR><TD BGCOLOR="#1e3a5f" COLSPAN="2"><FONT COLOR="white"><B>batches</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR>
        <TR><TD ALIGN="LEFT">batch_number</TD><TD ALIGN="LEFT">int</TD></TR>
        <TR><TD ALIGN="LEFT">batch_size</TD><TD ALIGN="LEFT">int</TD></TR>
        <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">enum</TD></TR>
      </TABLE>
    >
  ]

  jobs [
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#1e3a5f">
        <TR><TD BGCOLOR="#1e3a5f" COLSPAN="2"><FONT COLOR="white"><B>jobs</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR>
        <TR><TD ALIGN="LEFT">batch_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR>
        <TR><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT">enum</TD></TR>
        <TR><TD ALIGN="LEFT">gcs_input_uri</TD><TD ALIGN="LEFT">text</TD></TR>
        <TR><TD ALIGN="LEFT">gcs_stt_output_uri</TD><TD ALIGN="LEFT">text</TD></TR>
        <TR><TD ALIGN="LEFT">retry_count</TD><TD ALIGN="LEFT">int</TD></TR>
      </TABLE>
    >
  ]

  file_details [
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#1e3a5f">
        <TR><TD BGCOLOR="#1e3a5f" COLSPAN="2"><FONT COLOR="white"><B>file_details</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT">job_id</TD><TD ALIGN="LEFT">uuid PK/FK</TD></TR>
        <TR><TD ALIGN="LEFT">file_name</TD><TD ALIGN="LEFT">varchar</TD></TR>
        <TR><TD ALIGN="LEFT">state</TD><TD ALIGN="LEFT">varchar</TD></TR>
        <TR><TD ALIGN="LEFT">division</TD><TD ALIGN="LEFT">varchar</TD></TR>
        <TR><TD ALIGN="LEFT">zone</TD><TD ALIGN="LEFT">varchar</TD></TR>
        <TR><TD ALIGN="LEFT">data_source</TD><TD ALIGN="LEFT">varchar</TD></TR>
      </TABLE>
    >
  ]

  processed_file [
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#1e3a5f">
        <TR><TD BGCOLOR="#1e3a5f" COLSPAN="2"><FONT COLOR="white"><B>processed_file</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT">job_id</TD><TD ALIGN="LEFT">uuid PK/FK</TD></TR>
        <TR><TD ALIGN="LEFT">raw_transcript_text</TD><TD ALIGN="LEFT">text</TD></TR>
        <TR><TD ALIGN="LEFT">translated_text</TD><TD ALIGN="LEFT">text</TD></TR>
        <TR><TD ALIGN="LEFT">insights_raw_json</TD><TD ALIGN="LEFT">jsonb</TD></TR>
      </TABLE>
    >
  ]

  failed_jobs [
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#1e3a5f">
        <TR><TD BGCOLOR="#1e3a5f" COLSPAN="2"><FONT COLOR="white"><B>failed_jobs</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR>
        <TR><TD ALIGN="LEFT">job_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR>
        <TR><TD ALIGN="LEFT">pipeline_stage</TD><TD ALIGN="LEFT">varchar</TD></TR>
        <TR><TD ALIGN="LEFT">error_message</TD><TD ALIGN="LEFT">text</TD></TR>
      </TABLE>
    >
  ]

  products [
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#1e3a5f">
        <TR><TD BGCOLOR="#1e3a5f" COLSPAN="2"><FONT COLOR="white"><B>products</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">int PK</TD></TR>
        <TR><TD ALIGN="LEFT">product_name</TD><TD ALIGN="LEFT">varchar</TD></TR>
        <TR><TD ALIGN="LEFT">short_code</TD><TD ALIGN="LEFT">varchar</TD></TR>
        <TR><TD ALIGN="LEFT">is_active</TD><TD ALIGN="LEFT">boolean</TD></TR>
      </TABLE>
    >
  ]

  feedbacks [
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#1e3a5f">
        <TR><TD BGCOLOR="#1e3a5f" COLSPAN="2"><FONT COLOR="white"><B>feedbacks</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR>
        <TR><TD ALIGN="LEFT">job_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR>
        <TR><TD ALIGN="LEFT">product_id</TD><TD ALIGN="LEFT">int FK</TD></TR>
        <TR><TD ALIGN="LEFT">product_name</TD><TD ALIGN="LEFT">varchar</TD></TR>
        <TR><TD ALIGN="LEFT">group_type</TD><TD ALIGN="LEFT">varchar</TD></TR>
        <TR><TD ALIGN="LEFT">ai_summary</TD><TD ALIGN="LEFT">text</TD></TR>
      </TABLE>
    >
  ]

  feedback_tags [
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#1e3a5f">
        <TR><TD BGCOLOR="#1e3a5f" COLSPAN="2"><FONT COLOR="white"><B>feedback_tags</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT">tag_id</TD><TD ALIGN="LEFT">int PK</TD></TR>
        <TR><TD ALIGN="LEFT">tag_name</TD><TD ALIGN="LEFT">varchar</TD></TR>
        <TR><TD ALIGN="LEFT">sub_tag_name</TD><TD ALIGN="LEFT">varchar</TD></TR>
        <TR><TD ALIGN="LEFT">group_type</TD><TD ALIGN="LEFT">varchar</TD></TR>
        <TR><TD ALIGN="LEFT">category</TD><TD ALIGN="LEFT">varchar</TD></TR>
      </TABLE>
    >
  ]

  feedback_tag_link [
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#1e3a5f">
        <TR><TD BGCOLOR="#1e3a5f" COLSPAN="2"><FONT COLOR="white"><B>feedback_tag_link</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT">feedback_id</TD><TD ALIGN="LEFT">uuid PK/FK</TD></TR>
        <TR><TD ALIGN="LEFT">tag_id</TD><TD ALIGN="LEFT">int PK/FK</TD></TR>
      </TABLE>
    >
  ]

  feedback_competitors [
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#1e3a5f">
        <TR><TD BGCOLOR="#1e3a5f" COLSPAN="2"><FONT COLOR="white"><B>feedback_competitors</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT">uuid PK</TD></TR>
        <TR><TD ALIGN="LEFT">feedback_id</TD><TD ALIGN="LEFT">uuid FK</TD></TR>
        <TR><TD ALIGN="LEFT">competitor_name</TD><TD ALIGN="LEFT">varchar</TD></TR>
      </TABLE>
    >
  ]

  keyword_dictionary [
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#1e3a5f">
        <TR><TD BGCOLOR="#1e3a5f" COLSPAN="2"><FONT COLOR="white"><B>keyword_dictionary</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT">canonical_id</TD><TD ALIGN="LEFT">varchar PK</TD></TR>
        <TR><TD ALIGN="LEFT">canonical_term</TD><TD ALIGN="LEFT">varchar UK</TD></TR>
        <TR><TD ALIGN="LEFT">aliases</TD><TD ALIGN="LEFT">jsonb</TD></TR>
      </TABLE>
    >
  ]

  app_config [
    label=<
      <TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#1e3a5f">
        <TR><TD BGCOLOR="#1e3a5f" COLSPAN="2"><FONT COLOR="white"><B>app_config</B></FONT></TD></TR>
        <TR><TD ALIGN="LEFT">key</TD><TD ALIGN="LEFT">varchar PK</TD></TR>
        <TR><TD ALIGN="LEFT">value</TD><TD ALIGN="LEFT">jsonb</TD></TR>
      </TABLE>
    >
  ]

  { rank=same; batches; users }
  { rank=same; jobs; keyword_dictionary }
  { rank=same; file_details; processed_file; failed_jobs; app_config }
  { rank=same; products; feedbacks }
  { rank=same; feedback_tags; feedback_tag_link; feedback_competitors }

  batches -> jobs [label="batch_id  1:N"]
  jobs -> file_details [label="job_id  1:1"]
  jobs -> processed_file [label="job_id  1:0..1"]
  jobs -> failed_jobs [label="job_id  1:N"]
  jobs -> feedbacks [label="job_id  1:N"]
  products -> feedbacks [label="product_id  1:N"]
  feedbacks -> feedback_tag_link [label="feedback_id"]
  feedback_tags -> feedback_tag_link [label="tag_id"]
  feedbacks -> feedback_competitors [label="feedback_id  1:N"]
}
